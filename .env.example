# Copy to .env (never commit .env). Server refuses to boot if a required key is missing.
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
SESSION_SECRET=<at least 32 random characters>

GEMINI_API_KEY=<your Google AI Studio key>
# Optional. Check AI Studio for which model is on the free tier; default is set in server/src/config/env.ts
GEMINI_MODEL=

CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# Optional until features 02/14: id of the seeded Guest user (printed by scripts/seedDemoUser.ts)
DEMO_USER_ID=
